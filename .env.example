# Completa los valores únicamente en tu archivo local .env.
# No agregues contraseñas, tokens ni claves reales a este archivo de plantilla.
APP_PORT=
DB_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Supervisor con LLM (Google Gemini). Sin clave, el sistema usa el motor de reglas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Modelos de respaldo si el principal está saturado (503/429) o no disponible (404).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# Solo para modelos 2.5: 0 desactiva el razonamiento. Déjala vacía con modelos 3.x.
GEMINI_THINKING_BUDGET=
# Límites (opcionales): llamadas a agentes, tiempo máximo, tokens y uso.
LLM_MAX_TOOL_CALLS=6
LLM_TIMEOUT_MS=45000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_MAX_RETRIES=1
# Precio de pago por millón de tokens (solo para el costo estimado; el nivel gratuito es US$ 0).
LLM_PRICE_IN_PER_M=0.75
LLM_PRICE_OUT_PER_M=3.75
LLM_RATE_PER_MIN=10
LLM_DAILY_CAP=300
# Presupuesto diario de tokens; al alcanzarlo responde el motor de reglas hasta medianoche.
LLM_DAILY_TOKEN_CAP=1000000
APP_TZ=America/Lima

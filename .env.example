# Completa los valores únicamente en tu archivo local .env.
# No agregues contraseñas, tokens ni claves reales a este archivo de plantilla.
APP_PORT=
DB_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Usuario de demostración que se crea/actualiza al cargar la semilla (para el docente).
# La contraseña debe tener 10+ caracteres con letras y números. Roles: admin, comprador, lector.
DEMO_USER=
DEMO_PASSWORD=
DEMO_NOMBRE=Docente evaluador
DEMO_ROL=admin
# Duración de la sesión en horas.
SESSION_HOURS=8

# Supervisor con LLM (Google Gemini). Sin clave, el sistema usa el motor de reglas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Modelos de respaldo si el principal está saturado (503/429) o no disponible (404).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# Solo para modelos 2.5: 0 desactiva el razonamiento. Déjala vacía con modelos 3.x.
GEMINI_THINKING_BUDGET=
# Minutos que Gemini queda en pausa tras agotar la cuota (429); mientras tanto responde Groq.
GEMINI_PAUSA_CUOTA_MIN=15

# Respaldo con Groq (API compatible con OpenAI). Si Gemini falla o agota la cuota, responde Groq.
# Clave en console.groq.com → API Keys. Sin clave, el respaldo es el motor de reglas.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b
# Precio estimado por millón de tokens (solo para el costo mostrado; el plan gratuito es US$ 0).
GROQ_PRICE_IN_PER_M=0.59
GROQ_PRICE_OUT_PER_M=0.79
# Límites: llamadas a agentes, tiempo máximo, tokens y reintentos.
LLM_MAX_TOOL_CALLS=6
LLM_TIMEOUT_MS=45000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_MAX_RETRIES=1
# Precio de pago por millón de tokens (solo para el costo estimado; el nivel gratuito es US$ 0).
LLM_PRICE_IN_PER_M=0.75
LLM_PRICE_OUT_PER_M=3.75
# Topes de uso (los diarios se cuentan en PostgreSQL y sobreviven a reinicios).
LLM_RATE_PER_MIN=10
LLM_DAILY_CAP=300
LLM_DAILY_CAP_PER_USER=100
# Presupuesto diario de tokens; al alcanzarlo responde el motor de reglas hasta medianoche.
LLM_DAILY_TOKEN_CAP=1000000
SUPERVISOR_MAX_PER_MIN=30
DECISIONS_RATE_PER_MIN=30
LOGIN_RATE_PER_MIN=10
APP_TZ=America/Lima

# Detrás de un proxy (Render): cuántos valores finales de X-Forwarded-For agregan tus proxies.
TRUSTED_PROXY_HOPS=1
# TLS hacia PostgreSQL (verifica el certificado). INSECURE solo si el proveedor usa uno autofirmado.
DATABASE_SSL=
DATABASE_SSL_INSECURE=
# Solo para npm run local con una carpeta .pgdata creada por la versión anterior.
LOCAL_DB_PASSWORD=
